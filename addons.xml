  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>executable game</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>linux</platform>
    <language>en</language>
    <summary lang="en_GB">Moonlight Launcher for Kodi</summary>
    <description lang="en_GB">Luna Moonlight streaming for CoreELEC 21 NG 32-bit ARM only. Experimental test build; not compatible with CoreELEC 22 NO ARM64.</description>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  <license>GPL-3.0-or-later</license><minversion>21.0</minversion></extension>
</addon></addons>