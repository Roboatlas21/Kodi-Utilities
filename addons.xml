  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Cinema Controls</summary>
    <description lang="en_GB">Cinema Controls</description>
    <platform>all</platform><license>MIT</license><minversion>21.0</minversion>
  </extension>
</addon><addon id="script.kodi.utilities.setup" name="Kodi Utilities - Device Setup" version="0.1.38" provider-name="Kodi Utilities">
  <requires>
    <import addon="xbmc.python" version="3.0.1" />
  </requires>
  <extension point="xbmc.python.script" library="default.py" />
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Quick local settings and approved GitHub configuration</summary>
    <description lang="en_GB">Quick local device, subtitle size and startup title settings; preview, apply and restore approved Kodi settings. Shared profile settings never run automatically.</description>
    <platform>all</platform>
    <license>MIT</license>
    <minversion>21.0</minversion>
  </extension>
</addon><addon id="script.luna.ng" name="Luna NG (CoreELEC 21 ARM32 test)" version="2.7.1.306" provider-name="Vortex, Roboatlas21">
