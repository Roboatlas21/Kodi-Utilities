<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="repository.kodi.utilities" name="Kodi Utilities" version="1.0.0" provider-name="Kodi Utilities">
  <requires><import addon="xbmc.addon" version="20.0.0" /></requires>
  <extension point="xbmc.addon.repository" name="Kodi Utilities">
    <dir minversion="21.0.0">
      <info>https://raw.githubusercontent.com/Roboatlas21/Kodi-Utilities/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/Roboatlas21/Kodi-Utilities/main/addons.xml.md5</checksum>
      <datadir>https://raw.githubusercontent.com/Roboatlas21/Kodi-Utilities/main/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Kodi Utilities</summary>
    <description lang="en_GB">Kodi Utilities</description>
    <platform>all</platform><license>MIT</license>
  </extension>
</addon><addon id="service.cinema.controls" name="Cinema Controls" version="0.1.14" provider-name="Kodi Utilities">
  <requires><import addon="xbmc.python" version="3.0.1" /><import addon="plugin.video.jellyfin" version="1.0.0" /></requires>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Cinema Controls</summary>
    <description lang="en_GB">Cinema Controls</description>
    <platform>all</platform><license>MIT</license><minversion>21.0</minversion>
  </extension>
</addon><addon id="script.kodi.utilities.setup" name="Kodi Utilities - Device Setup" version="0.1.48" provider-name="Kodi Utilities">
  <requires>
    <import addon="xbmc.python" version="3.0.1" />
  </requires>
  <extension point="xbmc.python.script" library="default.py" />
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Quick local settings and approved GitHub configuration</summary>
    <description lang="en_GB">Quick local device, subtitle size and startup title settings; preview, apply and restore approved Kodi settings. Shared profile settings never run automatically.</description>
    <platform>all</platform>
    <license>MIT</license>
    <minversion>21.0</minversion>
  </extension>
</addon><addon id="script.luna.ng" name="Luna NG (CoreELEC 21 ARM32 test)" version="2.7.1.327" provider-name="Vortex, Roboatlas21">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>executable game</provides>
  </extension>
  <extension point="xbmc.service" library="artwork_service.py" start="login" />
  <extension point="xbmc.addon.metadata">
    <platform>linux</platform>
    <license>GPL-3.0-or-later</license>
    <minversion>21.0</minversion>
    <language>en</language>
    <summary lang="en_GB">Moonlight Launcher for Kodi</summary>
    <description lang="en_GB">Luna is a Moonlight Launcher for Kodi. [CR]Use Luna to play games using Nvidia's GameStream protocol. [CR]Resume and quit sessions from Kodi</description>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
<addon id="service.adaptive.letterbox.zoom" name="Adaptive Letterbox Zoom" version="0.1.2" provider-name="Roboatlas21">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Automatic letterbox zoom for CoreELEC P3I</summary>
    <description lang="en_GB">Reduce large letterbox bars using native video aspect ratio and supported Dolby Vision L5 metadata. Stop at the bars of a 2:1 picture on a 16:9 display or 115% zoom, whichever comes first. Requires the P3I info labels for Dolby Vision detection; SDR/HDR10 baked-in bars are not detected.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/Roboatlas21/Adaptive-Letterbox-Zoom</source>
    <news>Fix P3I AVChange storms repeatedly resetting L5 detection; recover from missed AVStarted; give manual zoom priority until the next movie or re-enable. Device validation remains required.</news>
  </extension>
</addon>
</addons>